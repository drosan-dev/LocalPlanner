                                        Content="Сохранить" />
                                <Button x:Name="CompleteTaskItemButton"
                                        Padding="16,8"
                                        Margin="0,0,10,10"
                                        Background="{StaticResource PanelSubtleBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Click="CompleteTaskItemButton_OnClick"
                                        Content="Готово"
                                        IsEnabled="False" />
                                <Button x:Name="ReopenTaskItemButton"
                                        Padding="16,8"
                                        Margin="0,0,10,10"
                                        Background="{StaticResource PanelSubtleBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Click="ReopenTaskItemButton_OnClick"
                                        Content="Вернуть"
                                        IsEnabled="False" />
                                <Button x:Name="ArchiveTaskItemButton"
                                        Padding="16,8"
                                        Margin="0,0,0,10"
                                        Background="{StaticResource DangerSurfaceBrush}"
                                        BorderBrush="{StaticResource DangerBorderBrush}"
                                        Foreground="{StaticResource DangerBrush}"
                                        Click="ArchiveTaskItemButton_OnClick"
                                        Content="В архив"
                                        IsEnabled="False" />
                            </WrapPanel>

                            <Border Padding="12"
                                    Background="{StaticResource PanelMutedBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrushStrong}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <TextBlock x:Name="TaskStatusTextBlock"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="Выберите задачу слева или создайте новую." />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ProjectsPageContent"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ProjectEditorSpacerColumn" Width="0" />
                <ColumnDefinition x:Name="ProjectEditorColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="22"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrushStrong}"
                    BorderThickness="1"
                    CornerRadius="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       Text="Контекст" />
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Text="Проекты" />
                            <TextBlock x:Name="ProjectsCountTextBlock"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Нет проектов" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Padding="14,9"
                                Background="{StaticResource AccentStrongBrush}"
                                BorderBrush="{StaticResource AccentStrongBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Click="NewProjectButton_OnClick"
                                Content="+ Проект" />
                    </Grid>

                    <ListBox x:Name="ProjectsListBox"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="ProjectsListBox_OnSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Background" Value="{StaticResource PanelMutedBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ProjectItemChrome"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="16">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ProjectItemChrome" Property="Background" Value="{StaticResource PanelSubtleBrush}" />
                                                    <Setter TargetName="ProjectItemChrome" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ProjectItemChrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                    <Setter TargetName="ProjectItemChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProjectListItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="14"
                                            Height="14"
                                            Margin="0,4,0,0"
                                            VerticalAlignment="Top"
                                            Background="{Binding Color}"
                                            CornerRadius="7" />

                                    <StackPanel Grid.Column="2">
                                        <TextBlock FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding StatusText}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding TagsText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="34"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrushStrong}"
                    BorderThickness="1"
                    CornerRadius="20">
                <Grid>
                    <StackPanel x:Name="ProjectEmptyStatePanel"
                                Width="520"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   Text="Основа планирования" />
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Text="Выберите или создайте проект"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="15"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Проекты сохраняются локально и позже станут контекстом для задач, рутин, трекеров и календарных элементов."
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="ProjectSelectedPanel"
                                Visibility="Collapsed">
                        <Border Width="56"
                                Height="56"
                                HorizontalAlignment="Left"
                                Background="{Binding SelectedItem.Color, ElementName=ProjectsListBox}"
                                CornerRadius="18" />
                        <TextBlock x:Name="SelectedProjectTitleTextBlock"
                                   Margin="0,18,0,0"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SelectedProjectStatusTextBlock"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedProjectDescriptionTextBlock"
                                   Margin="0,18,0,0"
                                   FontSize="15"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SelectedProjectTagsTextBlock"
                                   Margin="0,18,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                        <Button Margin="0,24,0,0"
                                Padding="16,9"
                                HorizontalAlignment="Left"
                                Background="{StaticResource PanelSubtleBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                Click="EditSelectedProjectButton_OnClick"
                                Content="Редактировать" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ProjectEditorPanelBorder"
                    Grid.Column="4"
                    Padding="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrushStrong}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Visibility="Collapsed">
                <ScrollViewer Margin="18,18,0,18"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,18,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="24"
                                           FontWeight="SemiBold"
                                           Text="Проект" />
                                <TextBlock x:Name="ProjectEditorSubtitleTextBlock"
                                           Margin="0,6,0,18"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Новый контекст" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Click="CloseProjectEditorButton_OnClick"
                                    Content="✕" />
                        </Grid>

                        <TextBlock FontWeight="SemiBold"
                                   Text="Название" />
                        <TextBox x:Name="ProjectTitleTextBox"
                                 Margin="0,6,0,14"
                                 Padding="10" />

                        <TextBlock FontWeight="SemiBold"
                                   Text="Описание" />
                        <TextBox x:Name="ProjectDescriptionTextBox"
                                 Margin="0,6,0,14"
                                 Padding="10"
                                 AcceptsReturn="True"
                                 Height="96"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock FontWeight="SemiBold"
                                   Text="Цвет" />
                        <ComboBox x:Name="ProjectColorComboBox"
                                  Margin="0,6,0,14"
                                  Padding="14,10"
                                  Style="{StaticResource EditorFieldComboBoxStyle}">
                            <ComboBoxItem Content="Синий" Tag="#FF4F8DFD" />
                            <ComboBoxItem Content="Зелёный" Tag="#FF34A853" />
                            <ComboBoxItem Content="Жёлтый" Tag="#FFF9AB00" />
                            <ComboBoxItem Content="Красный" Tag="#FFEA4335" />
                            <ComboBoxItem Content="Фиолетовый" Tag="#FFA78BFA" />
                        </ComboBox>

                        <TextBlock FontWeight="SemiBold"
                                   Text="Статус" />
                        <ComboBox x:Name="ProjectStatusComboBox"
                                  Margin="0,6,0,14"
                                  Padding="14,10"
                                  Style="{StaticResource EditorFieldComboBoxStyle}">
                            <ComboBoxItem Content="Активен" Tag="Active" />
                            <ComboBoxItem Content="На паузе" Tag="Paused" />
                            <ComboBoxItem Content="Завершён" Tag="Completed" />
                        </ComboBox>

                        <TextBlock FontWeight="SemiBold"
                                   Text="Теги" />
                        <TextBox x:Name="ProjectTagsTextBox"
                                 Margin="0,6,0,8"
                                 Padding="10" />
                        <TextBlock Margin="0,0,0,18"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Через запятую: дом, здоровье, работа" />

                        <WrapPanel Margin="0,0,0,16">
                            <Button Padding="16,8"
                                    Margin="0,0,10,10"
                                    Background="{StaticResource AccentStrongBrush}"
                                    BorderBrush="{StaticResource AccentStrongBrush}"
                                    Foreground="White"
                                    Click="SaveProjectButton_OnClick"
                                    Content="Сохранить" />
                            <Button Padding="16,8"
                                    Margin="0,0,0,10"
                                    Background="{StaticResource PanelSubtleBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    Click="NewProjectButton_OnClick"
                                    Content="Новый проект" />
                        </WrapPanel>

                        <Border Padding="12"
                                Background="{StaticResource PanelMutedBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrushStrong}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock x:Name="ProjectStatusTextBlock"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="CalendarPageContent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="EditorSpacerColumn" Width="0" />
            <ColumnDefinition x:Name="EditorColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="18"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushStrong}"
                BorderThickness="1"
                CornerRadius="20"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="26"
                           FontWeight="SemiBold"
                           Text="Календарь" />

                <Button Grid.Row="2"
                        Padding="16,10"
                        HorizontalAlignment="Left"
                        Background="{StaticResource AccentStrongBrush}"
                        BorderBrush="{StaticResource AccentStrongBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Click="NewButton_OnClick"
                        Content="+ Создать" />

                <Border Grid.Row="4"
                        Padding="10"
                        Background="{StaticResource PanelMutedBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrushStrong}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Calendar x:Name="MiniCalendar"
                              Background="Transparent"
                              BorderThickness="0"
                              Loaded="Calendar_OnLoaded"
                              SelectedDatesChanged="MiniCalendar_OnSelectedDatesChanged" />
                </Border>

                <StackPanel Grid.Row="6">
                    <TextBlock x:Name="SelectedDateTitleTextBlock"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="События на сегодня" />
                    <TextBlock x:Name="SelectedDateSubtitleTextBlock"
                               Margin="0,4,0,14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Нет событий" />

                    <Button x:Name="QuickCreateSelectedDateButton"
                            Margin="0,0,0,14"
                            Padding="14,9"
                            HorizontalAlignment="Left"
                            Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="#554F8DFD"
                            Foreground="{StaticResource AccentBrush}"
                            FontWeight="SemiBold"
                            Click="QuickCreateSelectedDateButton_OnClick"
                            Content="Создать на выбранный день" />

                    <ListBox x:Name="DailyEventsListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ItemTemplate="{StaticResource EventCardTemplate}"
                             SelectionChanged="EventsListBox_OnSelectionChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Padding="20"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushStrong}"
                BorderThickness="1"
                CornerRadius="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Width="38"
                            Height="38"
                            Background="{StaticResource PanelSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            FontSize="18"
                            Click="PreviousRangeButton_OnClick"
                            Content="вЂ№" />
                    <Button Grid.Column="2"
                            Width="38"
                            Height="38"
                            Background="{StaticResource PanelSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            FontSize="18"
                            Click="NextRangeButton_OnClick"
                            Content="вЂє" />

                    <StackPanel Grid.Column="4"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentRangeTextBlock"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Text="Месяц" />
                        <TextBlock x:Name="CurrentRangeSubtitleTextBlock"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="События выбранного дня" />
                    </StackPanel>

                    <Border Grid.Column="5"
                            Padding="4"
                            Background="{StaticResource PanelMutedBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushStrong}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DayViewRadioButton"
                                         GroupName="ViewMode"
                                         Style="{StaticResource ViewModeRadioButtonStyle}"
                                         Tag="Day"
                                         Checked="ViewModeRadioButton_OnChecked"
                                         Content="День" />
                            <RadioButton x:Name="WeekViewRadioButton"
                                         GroupName="ViewMode"
                                         Style="{StaticResource ViewModeRadioButtonStyle}"
                                         Tag="Week"
                                         Checked="ViewModeRadioButton_OnChecked"
                                         Content="Неделя" />
                            <RadioButton x:Name="MonthViewRadioButton"
                                         GroupName="ViewMode"
                                         Style="{StaticResource ViewModeRadioButtonStyle}"
                                         Tag="Month"
                                         Checked="ViewModeRadioButton_OnChecked"
                                         Content="Месяц" />
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="7"
                            Padding="16,10"
                            Background="{StaticResource PanelSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            Click="TodayButton_OnClick"
                            Content="Сегодня" />
                </Grid>

                <Grid Grid.Row="2">
                    <Border x:Name="MonthViewContainer"
                            Padding="12"
                            Background="{StaticResource PanelMutedBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushStrong}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Calendar x:Name="MonthCalendar"
                                      Height="0"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Loaded="Calendar_OnLoaded"
                                      SelectedDatesChanged="MonthCalendar_OnSelectedDatesChanged"
                                      DisplayDateChanged="MonthCalendar_OnDisplayDateChanged"
                                      Visibility="Collapsed" />

                            <ItemsControl x:Name="MonthHeadersItemsControl"
                                          Grid.Row="0"
                                          ItemTemplate="{StaticResource MonthHeaderTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <ItemsControl x:Name="MonthCellsItemsControl"
                                          Grid.Row="1"
                                          ItemTemplate="{StaticResource MonthCellTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7"
                                                     Rows="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border x:Name="WeekViewContainer"
                            Padding="16"
                            Background="{StaticResource PanelMutedBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushStrong}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}" />
                                </ScrollViewer.Resources>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,8,0" />

                                    <ItemsControl Grid.Row="0"
                                                  Grid.Column="1"
                                                  x:Name="WeekHeadersItemsControl"
                                                  ItemTemplate="{StaticResource WeekHeaderTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="7" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <ItemsControl x:Name="WeekHoursItemsControl"
                                                  Grid.Row="2"
                                                  Grid.Column="0"
                                                  ItemTemplate="{StaticResource TimelineHourTemplate}" />

                                    <Grid Grid.Row="2"
                                          Grid.Column="1">
                                        <ItemsControl x:Name="WeekBodiesItemsControl">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:WeekDayColumnViewModel}">
                                                    <Border Margin="6,0"
                                                            Background="#2218253B"
                                                            BorderBrush="{StaticResource BorderBrushStrong}"
                                                            BorderThickness="1"
                                                            CornerRadius="14">
                                                        <Grid Height="1536">
                                                            <Border Background="Transparent"
                                                                    MouseLeftButtonDown="TimelineCreateSurface_OnMouseLeftButtonDown"
                                                                    MouseLeftButtonUp="TimelineInteractionSurface_OnMouseLeftButtonUp"
                                                                    MouseMove="TimelineInteractionSurface_OnMouseMove"
                                                                    LostMouseCapture="TimelineInteractionSurface_OnLostMouseCapture" />

                                                            <ItemsControl ItemsSource="{Binding TimeSlots}"
                                                                          ItemTemplate="{StaticResource TimelineSlotLineTemplate}" />

                                                            <TextBlock Margin="14,14,14,0"
                                                                       VerticalAlignment="Top"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       Text="Нет событий"
                                                                       Visibility="{Binding EmptyStateVisibility}" />

                                                            <ItemsControl ItemsSource="{Binding TimeGridEvents}"
                                                                          ItemTemplate="{StaticResource TimelineEventTemplate}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <Canvas />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="Canvas.Left" Value="0" />
                                                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Canvas x:Name="WeekDragPreviewCanvas"
                                                IsHitTestVisible="False"
                                                Visibility="Collapsed"
                                                Panel.ZIndex="20">
                                            <Border x:Name="WeekDragPreviewCard"
                                                    Width="120"
                                                    Height="64"
                                                    CornerRadius="12"
                                                    BorderThickness="1"
                                                    Opacity="0.96">
                                                <Grid Margin="10,8,10,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock x:Name="WeekDragPreviewTitleTextBlock"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="WeekDragPreviewTimeTextBlock"
                                                               Grid.Row="1"
                                                               Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                    <TextBlock x:Name="WeekDragPreviewDescriptionTextBlock"
                                                               Grid.Row="2"
                                                               Margin="0,4,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </Canvas>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border x:Name="DayViewContainer"
                            Padding="18"
                            Background="{StaticResource PanelMutedBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushStrong}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="DayAgendaTitleTextBlock"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="Повестка дня" />
                                <TextBlock x:Name="DayAgendaSubtitleTextBlock"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Выбранный день" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}" />
                                </ScrollViewer.Resources>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ItemsControl x:Name="DayHoursItemsControl"
                                                  Grid.Column="0"
                                                  ItemTemplate="{StaticResource TimelineHourTemplate}" />

                                    <Grid Grid.Column="1"
                                          Height="1536">
                                        <Border Background="Transparent"
                                                MouseLeftButtonDown="TimelineCreateSurface_OnMouseLeftButtonDown"
                                                MouseLeftButtonUp="TimelineInteractionSurface_OnMouseLeftButtonUp"
                                                MouseMove="TimelineInteractionSurface_OnMouseMove"
                                                LostMouseCapture="TimelineInteractionSurface_OnLostMouseCapture" />

                                        <ItemsControl x:Name="DaySlotLinesItemsControl"
                                                      ItemTemplate="{StaticResource TimelineSlotLineTemplate}" />

                                        <TextBlock x:Name="DayAgendaEmptyTextBlock"
                                                   Margin="14,14,14,0"
                                                   VerticalAlignment="Top"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="На выбранный день событий нет."
                                                   Visibility="Collapsed" />

                                        <ItemsControl x:Name="DayTimelineItemsControl"
                                                      ItemTemplate="{StaticResource TimelineEventTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="0" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>

                                        <Canvas x:Name="DayDragPreviewCanvas"
                                                IsHitTestVisible="False"
                                                Visibility="Collapsed"
                                                Panel.ZIndex="20">
                                            <Border x:Name="DayDragPreviewCard"
                                                    Width="120"
                                                    Height="64"
                                                    CornerRadius="12"
                                                    BorderThickness="1"
                                                    Opacity="0.96">
                                                <Grid Margin="10,8,10,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock x:Name="DayDragPreviewTitleTextBlock"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="DayDragPreviewTimeTextBlock"
                                                               Grid.Row="1"
                                                               Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                    <TextBlock x:Name="DayDragPreviewDescriptionTextBlock"
                                                               Grid.Row="2"
                                                               Margin="0,4,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </Canvas>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="EditorPanelBorder"
                Grid.Column="4"
                Padding="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushStrong}"
                BorderThickness="1"
                CornerRadius="20"
                Visibility="Collapsed">
            <ScrollViewer Margin="18,18,0,18"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}" />
                </ScrollViewer.Resources>
                <StackPanel Margin="0,0,18,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="24"
                                       FontWeight="SemiBold"
                                       Text="Сведения" />
                            <TextBlock Margin="0,6,0,18"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Событие" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="36"
                                Height="36"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Click="CloseEditorButton_OnClick"
                                Content="✕" />
                    </Grid>

                    <Border Margin="0,0,0,18"
                            Padding="14"
                            Background="{StaticResource PanelMutedBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushStrong}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel>
                            <TextBlock x:Name="EditorModeTitleTextBlock"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Новое событие" />
                            <TextBlock x:Name="EditorModeSubtitleTextBlock"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Заполните основные детали." />
                        </StackPanel>
                    </Border>

                    <TextBlock FontWeight="SemiBold"
                               Text="Название" />
                    <TextBox x:Name="TitleTextBox"
                             Margin="0,6,0,14"
                             Padding="10" />

                    <TextBlock FontWeight="SemiBold"
                               Text="Описание" />
                    <TextBox x:Name="DescriptionTextBox"
                             Margin="0,6,0,14"
                             Padding="10"
                             AcceptsReturn="True"
                             Height="96"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Начало" />
                            <Border Margin="0,8,0,2"
                                    Style="{StaticResource EditorGroupCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EditorSectionLabelStyle}"
                                               Text="&#x0414;&#x0430;&#x0442;&#x0430;" />
                                <DatePicker x:Name="StartDatePicker"
                                            Margin="0,6,0,0"
                                            Style="{StaticResource EditorDatePickerStyle}" />
                                <TextBlock Margin="0,12,0,0"
                                           Style="{StaticResource EditorSectionLabelStyle}"
                                           Text="&#x0412;&#x0440;&#x0435;&#x043C;&#x044F;" />
                                <TextBox x:Name="StartTimeTextBox"
                                         Margin="0,6,0,0"
                                         Style="{StaticResource EditorTimeTextBoxStyle}"
                                         Text="09:00" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Окончание" />
                            <Border Margin="0,8,0,2"
                                    Style="{StaticResource EditorGroupCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EditorSectionLabelStyle}"
                                               Text="&#x0414;&#x0430;&#x0442;&#x0430;" />
                                <DatePicker x:Name="EndDatePicker"
                                            Margin="0,6,0,0"
                                            Style="{StaticResource EditorDatePickerStyle}" />
                                <TextBlock Margin="0,12,0,0"
                                           Style="{StaticResource EditorSectionLabelStyle}"
                                           Text="&#x0412;&#x0440;&#x0435;&#x043C;&#x044F;" />
                                <TextBox x:Name="EndTimeTextBox"
                                         Margin="0,6,0,0"
                                         Style="{StaticResource EditorTimeTextBoxStyle}"
                                         Text="10:00" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock FontWeight="SemiBold"
                               Text="Часовой пояс" />
                    <ComboBox x:Name="TimezoneComboBox"
                              Margin="0,6,0,14"
                              Padding="14,10"
                              Style="{StaticResource EditorFieldComboBoxStyle}"
                              DisplayMemberPath="Id" />

                    <CheckBox x:Name="AllDayCheckBox"
                              Margin="0,0,0,14"
                              Content="Весь день" />

                    <TextBlock FontWeight="SemiBold"
                               Text="Повторяемость (RRULE)" />
                    <TextBox x:Name="RRuleTextBox"
                             Margin="0,6,0,18"
                             Padding="10" />

                    <WrapPanel Margin="0,0,0,16">
                        <Button Padding="16,8"
                                Margin="0,0,10,10"
                                Background="{StaticResource AccentStrongBrush}"
                                BorderBrush="{StaticResource AccentStrongBrush}"
                                Foreground="White"
                                Click="SaveButton_OnClick"
                                Content="Сохранить" />
                        <Button Padding="16,8"
                                Margin="0,0,10,10"
                                Background="{StaticResource PanelSubtleBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                Click="NewButton_OnClick"
                                Content="Новое событие" />
                        <Button x:Name="DeleteButton"
                                Padding="16,8"
                                Margin="0,0,0,10"
                                Background="{StaticResource DangerSurfaceBrush}"
                                BorderBrush="{StaticResource DangerBorderBrush}"
                                Foreground="{StaticResource DangerBrush}"
                                Click="DeleteButton_OnClick"
                                Content="Удалить"
                                IsEnabled="False" />
                    </WrapPanel>

                    <Border Padding="12"
                            Background="{StaticResource PanelMutedBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushStrong}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <TextBlock x:Name="StatusTextBlock"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
    </Grid>
    </Grid>
</Window>

