<Window x:Class="LocalPlanner.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:LocalPlanner.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Локальный календарь"
        Width="1440"
        Height="860"
        MinWidth="1180"
        MinHeight="720"
        Background="#FF0B1220"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF0B1220" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF111827" />
        <SolidColorBrush x:Key="PanelMutedBackgroundBrush" Color="#FF0F172A" />
        <SolidColorBrush x:Key="PanelElevatedBrush" Color="#FF132136" />
        <SolidColorBrush x:Key="PanelSubtleBrush" Color="#FF18253B" />
        <SolidColorBrush x:Key="BorderBrushStrong" Color="#FF243042" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#FF304057" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE5E7EB" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFB6C2D2" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF7F8EA3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF8AB4F8" />
        <SolidColorBrush x:Key="AccentStrongBrush" Color="#FF4F8DFD" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#332D6CDF" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFF28B82" />
        <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#332F1C1B" />
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#FF6D3B3A" />
        <SolidColorBrush x:Key="TimelineGridBrush" Color="#1F42526C" />
        <SolidColorBrush x:Key="TimelineMinorTextBrush" Color="#FF94A3B8" />
        <SolidColorBrush x:Key="TimelineResizeBrush" Color="#FFDCE7FB" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavButtonChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavButtonChrome" Property="Background" Value="{StaticResource PanelSubtleBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavButtonChrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="NavButtonChrome" Property="BorderBrush" Value="#554F8DFD" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatChromeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="TaskCompletionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">
                            <Ellipse x:Name="TaskCheckCircle"
                                     Fill="{StaticResource PanelSubtleBrush}"
                                     Stroke="{StaticResource BorderBrushSoft}"
                                     StrokeThickness="1.5" />
                            <Path x:Name="TaskCheckMark"
                                  Width="12"
                                  Height="9"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1 4.8 L 4.4 8 L 11 1"
                                  Stretch="Fill"
                                  Stroke="White"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="2.2"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TaskCheckCircle" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="TaskCheckCircle" Property="Fill" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TaskCheckCircle" Property="Fill" Value="{StaticResource AccentStrongBrush}" />
                                <Setter TargetName="TaskCheckCircle" Property="Stroke" Value="{StaticResource AccentStrongBrush}" />
                                <Setter TargetName="TaskCheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TaskItemTemplate">
            <Border Margin="0,0,0,10"
                    Padding="14"
                    Background="{StaticResource PanelMutedBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrushStrong}"
                    BorderThickness="1"
                    CornerRadius="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox VerticalAlignment="Top"
                              IsChecked="{Binding IsCompleted, Mode=OneWay}"
                              Style="{StaticResource TaskCompletionCheckBoxStyle}"
                              Tag="{Binding Id}"
                              Click="ToggleTaskItemCompletionCheckBox_OnClick" />

                    <StackPanel Grid.Column="2">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{Binding Title}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel Margin="0,7,0,0">
                            <TextBlock Margin="0,0,14,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding ProjectTitle, TargetNullValue=Без проекта}" />
                            <TextBlock Foreground="{StaticResource AccentBrush}"
                                       Text="{Binding DueText}" />
                        </WrapPanel>
                    </StackPanel>

                    <Button Grid.Column="4"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            Background="{StaticResource PanelSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Tag="{Binding Id}"
                            Click="OpenTaskItemButton_OnClick"
                            Content="Открыть" />
                </Grid>
            </Border>
        </DataTemplate>

        <Style TargetType="Calendar">
            <Setter Property="Background" Value="{StaticResource PanelMutedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
        </Style>

        <Style TargetType="CalendarButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelMutedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PanelSubtleBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentStrongBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentStrongBrush}" />
                </Trigger>
                <Trigger Property="IsInactive" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                </Trigger>
                <Trigger Property="IsToday" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="EditorFieldBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{StaticResource PanelMutedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style x:Key="EditorGroupCardStyle" TargetType="Border" BasedOn="{StaticResource EditorFieldBorderStyle}">
            <Setter Property="Padding" Value="14,14" />
        </Style>

        <Style x:Key="AppScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border Margin="2,0"
                                    Background="{StaticResource PanelMutedBackgroundBrush}"
                                    CornerRadius="6"
                                    Opacity="0.9" />
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{x:Null}"
                                                  IsTabStop="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AppScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{x:Null}"
                                                  IsTabStop="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="10" />
                                <Setter Property="Width" Value="Auto" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Track" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorFieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{StaticResource PanelMutedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="EditorFieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="EditorFieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EditorFieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorTimeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource EditorFieldTextBoxStyle}">
            <Setter Property="Width" Value="78" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="EditorFieldComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="2"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PanelSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsKeyboardFocusWithin" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorFieldComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{StaticResource PanelMutedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource EditorFieldComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBoxBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      IsHitTestVisible="False" />
                                    <TextBlock Grid.Column="1"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="&#xE70D;" />
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Margin="0,8,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource PanelMutedBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrushStrong}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                    <ScrollViewer Margin="6"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup" Property="MinHeight" Value="40" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#332D6CDF" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#332D6CDF" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFE5E7EB" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF0F172A" />
            </Style.Resources>
        </Style>

        <Style x:Key="EditorDatePickerTextBoxStyle" TargetType="{x:Type primitives:DatePickerTextBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="SelectedDateFormat" Value="Short" />
            <Setter Property="CalendarStyle" Value="{StaticResource {x:Type Calendar}}" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="DatePickerBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <primitives:DatePickerTextBox x:Name="PART_TextBox"
                                                              Grid.Column="0"
                                                              Margin="{TemplateBinding Padding}"
                                                              Background="Transparent"
                                                              VerticalAlignment="Center"
                                                              Style="{StaticResource EditorDatePickerTextBoxStyle}" />
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Margin="0"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        Focusable="False"
                                        Foreground="{StaticResource TextSecondaryBrush}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                                FontSize="9"
                                               Text="&#xE70D;" />
                                </Button>
                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       PopupAnimation="Fade"
                                       StaysOpen="False">
                                    <Border Margin="0,8,0,0"
                                            Background="{StaticResource PanelMutedBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrushStrong}"
                                            BorderThickness="1"
                                            CornerRadius="18">
                                        <Calendar x:Name="PART_Calendar"
                                                  Margin="8"
                                                  BorderThickness="0"
                                                  Background="{StaticResource PanelMutedBackgroundBrush}"
                                                  Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DatePickerBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="PART_Button" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DatePickerBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="PART_Button" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type primitives:CalendarItem}">
            <Setter Property="Background" Value="{StaticResource PanelMutedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>

        <Style x:Key="ViewModeRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource PanelElevatedBrush}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="EventCardTemplate" DataType="{x:Type vm:EventListItemViewModel}">
            <Border Margin="0,0,0,10"
                    Background="{Binding AccentSurfaceBrush}"
                    BorderBrush="{Binding AccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    PreviewMouseLeftButtonDown="EventCard_OnPreviewMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{Binding AccentBrush}"
                            CornerRadius="14,0,0,14" />

                    <StackPanel Grid.Column="1"
                                Margin="12,12,12,12">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding Title}" />
                            <Border Margin="8,0,0,0"
                                    Padding="8,2"
                                    Background="{Binding AccentBadgeBrush}"
                                    CornerRadius="10">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding AccentBrush}"
                                           Text="{Binding TimeLabel}" />
                            </Border>
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding ScheduleSummary}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Description}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TimelineHourTemplate" DataType="{x:Type vm:TimeSlotViewModel}">
            <Grid Height="64">
                <TextBlock Margin="0,2,10,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Foreground="{StaticResource TimelineMinorTextBrush}"
                           FontSize="11"
                           Text="{Binding Label}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TimelineSlotLineTemplate" DataType="{x:Type vm:TimeSlotViewModel}">
            <Border Height="64"
                    BorderBrush="{StaticResource TimelineGridBrush}"
                    BorderThickness="0,0,0,1" />
        </DataTemplate>

        <DataTemplate x:Key="WeekHeaderTemplate" DataType="{x:Type vm:WeekDayColumnViewModel}">
            <Border x:Name="WeekHeaderBorder"
                    Margin="6,0"
                    Padding="12,10"
                    Background="{Binding SurfaceBrush}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="{Binding BorderThickness}"
                    CornerRadius="14">
                <Button Padding="0"
                        Style="{StaticResource FlatChromeButtonStyle}"
                        HorizontalContentAlignment="Left"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Click="WeekDayButton_OnClick"
                        Tag="{Binding Date}">
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding DayOfWeekLabel}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding DayNumberLabel}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding SummaryLabel}" />
                    </StackPanel>
                </Button>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="WeekHeaderBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="WeekHeaderBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="MonthHeaderTemplate" DataType="{x:Type vm:MonthHeaderViewModel}">
            <Border Margin="4,0,4,8"
                    Padding="10,0">
                <TextBlock HorizontalAlignment="Left"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="{Binding Label}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MonthEventChipTemplate" DataType="{x:Type vm:MonthEventChipViewModel}">
            <Button Margin="0,2,0,0"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    Background="{Binding AccentSurfaceBrush}"
                    BorderBrush="{Binding AccentBorderBrush}"
                    BorderThickness="1"
                    Click="MonthEventChip_OnClick"
                    PreviewMouseLeftButtonDown="MonthEvent_OnPreviewMouseLeftButtonDown"
                    PreviewMouseMove="MonthEvent_OnPreviewMouseMove"
                    Style="{StaticResource FlatChromeButtonStyle}"
                    FocusVisualStyle="{x:Null}"
                    Tag="{Binding Id}">
                <Border Padding="6,3"
                        Background="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Background}"
                        BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=BorderBrush}"
                        BorderThickness="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=BorderThickness}"
                        CornerRadius="8">
                    <DockPanel LastChildFill="True">
                        <Ellipse DockPanel.Dock="Left"
                                 Width="6"
                                 Height="6"
                                 Margin="0,0,5,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding AccentBrush}" />
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="11"
                                   Text="{Binding DisplayText}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="MonthEventBarTemplate" DataType="{x:Type vm:MonthEventBarViewModel}">
            <Button Margin="{Binding Margin}"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    Background="{Binding AccentSurfaceBrush}"
                    BorderBrush="{Binding AccentBorderBrush}"
                    BorderThickness="1"
                    Click="MonthEventChip_OnClick"
                    PreviewMouseLeftButtonDown="MonthEvent_OnPreviewMouseLeftButtonDown"
                    PreviewMouseMove="MonthEvent_OnPreviewMouseMove"
                    Style="{StaticResource FlatChromeButtonStyle}"
                    FocusVisualStyle="{x:Null}"
                    Tag="{Binding Id}"
                    Visibility="{Binding Visibility}">
                <Border MinHeight="24"
                        Padding="7,3"
                        Background="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Background}"
                        BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=BorderBrush}"
                        BorderThickness="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=BorderThickness}"
                        CornerRadius="{Binding CornerRadius}">
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="{Binding DisplayText}"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="MonthCellTemplate" DataType="{x:Type vm:MonthDayCellViewModel}">
            <Border Margin="4"
                    Padding="8"
                    Background="{Binding SurfaceBrush}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="{Binding BorderThickness}"
                    CornerRadius="14"
                    Cursor="Hand"
                    MouseLeftButtonDown="MonthCell_OnMouseLeftButtonDown"
                    MouseLeftButtonUp="MonthCell_OnMouseLeftButtonUp"
                    MouseEnter="MonthCell_OnMouseEnter"
                    AllowDrop="True"
                    DragOver="MonthCell_OnDragOver"
                    Drop="MonthCell_OnDrop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Foreground="{Binding DayNumberBrush}"
                               FontSize="14"
                               FontWeight="{Binding DayNumberWeight}"
                               Text="{Binding DayNumberLabel}" />

                    <StackPanel Grid.Row="1"
                                Margin="0,6,0,0">
                        <ItemsControl ItemTemplate="{StaticResource MonthEventBarTemplate}"
                                      ItemsSource="{Binding EventBars}" />
                        <ItemsControl ItemTemplate="{StaticResource MonthEventChipTemplate}"
                                      ItemsSource="{Binding VisibleChips}" />
                    </StackPanel>

                    <Button Grid.Row="2"
                            Margin="0,4,0,0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            Foreground="{StaticResource AccentBrush}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Style="{StaticResource FlatChromeButtonStyle}"
                            Content="{Binding OverflowLabel}"
                            Visibility="{Binding OverflowVisibility}"
                            Click="MonthOverflowButton_OnClick"
                            Tag="{Binding Date}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TimelineEventTemplate" DataType="{x:Type vm:TimeGridEventViewModel}">
            <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=Canvas}, Path=ActualWidth}"
                  Height="{Binding Height}">
                <Grid Margin="6,0,6,0"
                      Background="Transparent"
                      Cursor="SizeAll"
                      PreviewMouseLeftButtonDown="TimelineEventThumb_OnPreviewMouseLeftButtonDown"
                      PreviewMouseLeftButtonUp="TimelineInteractionSurface_OnMouseLeftButtonUp"
                      PreviewMouseMove="TimelineInteractionSurface_OnMouseMove"
                      LostMouseCapture="TimelineInteractionSurface_OnLostMouseCapture">
                    <Border Background="{Binding AccentSurfaceBrush}"
                            BorderBrush="{Binding AccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid Margin="10,8,10,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding Title}" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{Binding AccentBrush}"
                                       Text="{Binding TimeLabel}" />
                            <TextBlock Grid.Row="2"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding Description}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Height="10"
                            Tag="TimelineResizeHandle"
                            VerticalAlignment="Bottom"
                            Cursor="SizeNS"
                            Background="Transparent"
                            PreviewMouseLeftButtonDown="TimelineResizeSurface_OnMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="TimelineInteractionSurface_OnMouseLeftButtonUp"
                            PreviewMouseMove="TimelineInteractionSurface_OnMouseMove"
                            LostMouseCapture="TimelineInteractionSurface_OnLostMouseCapture">
                        <Border Height="4"
                                Margin="22,0,22,2"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource TimelineResizeBrush}"
                                CornerRadius="3"
                                Opacity="0.9" />
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReadOnlyTimelineEventTemplate" DataType="{x:Type vm:TimeGridEventViewModel}">
            <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=Canvas}, Path=ActualWidth}"
                  Height="{Binding Height}">
                <Border Margin="6,0,6,0"
                        Background="{Binding AccentSurfaceBrush}"
                        BorderBrush="{Binding AccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid Margin="10,8,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{Binding AccentBrush}"
                                   Text="{Binding TimeLabel}" />
                        <TextBlock Grid.Row="2"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding Description}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TodayOverviewItemTemplate" DataType="{x:Type vm:TodayOverviewItemViewModel}">
            <Border Margin="0,0,0,10"
                    Padding="13,11"
                    Background="{StaticResource PanelMutedBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrushStrong}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="TodayTaskCompletionCheckBox"
                              VerticalAlignment="Top"
                              IsChecked="False"
                              Style="{StaticResource TaskCompletionCheckBoxStyle}"
                              Tag="{Binding}"
                              Click="TodayTaskCompletionCheckBox_OnClick" />

                    <StackPanel Grid.Column="2">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding Title}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Detail}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="4"
                            Padding="10,7"
                            VerticalAlignment="Center"
                            Background="{StaticResource PanelSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            Click="TodayOverviewItemButton_OnClick"
                            Tag="{Binding}"
                            Content="{Binding BadgeText}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsTask}" Value="False">
                    <Setter TargetName="TodayTaskCompletionCheckBox" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220" />
            <ColumnDefinition x:Name="SidebarSpacerColumn" Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarBorder"
                Grid.Column="0"
                Padding="18"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushStrong}"
                BorderThickness="1"
                CornerRadius="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="SidebarHeaderContent">
                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="Local Planner" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Рабочее пространство" />
                    </StackPanel>

                    <Button x:Name="SidebarToggleButton"
                            Grid.Column="1"
                            Width="34"
                            Height="34"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{StaticResource PanelSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            Click="SidebarToggleButton_OnClick"
                            Content="☰"
                            ToolTip="Свернуть навигацию" />
                </Grid>

                <StackPanel x:Name="SidebarNavigationContent"
                            Grid.Row="2">
                    <RadioButton x:Name="TodayNavRadioButton"
                                 Content="Сегодня"
                                 HorizontalContentAlignment="Left"
                                 GroupName="PlannerNavigation"
                                 Tag="Today"
                                 Checked="NavigationRadioButton_OnChecked"
                                 Style="{StaticResource SidebarNavButtonStyle}" />
                    <RadioButton x:Name="PlanningNavRadioButton"
                                 Content="Планирование"
                                 HorizontalContentAlignment="Left"
                                 GroupName="PlannerNavigation"
                                 Tag="Planning"
                                 Checked="NavigationRadioButton_OnChecked"
                                 Style="{StaticResource SidebarNavButtonStyle}" />
                    <RadioButton x:Name="TasksNavRadioButton"
                                 Content="Задачи"
                                 HorizontalContentAlignment="Left"
                                 GroupName="PlannerNavigation"
                                 Tag="Tasks"
                                 Checked="NavigationRadioButton_OnChecked"
                                 Style="{StaticResource SidebarNavButtonStyle}" />
                    <RadioButton x:Name="ProjectsNavRadioButton"
                                 Content="Проекты"
                                 HorizontalContentAlignment="Left"
                                 GroupName="PlannerNavigation"
                                 Tag="Projects"
                                 Checked="NavigationRadioButton_OnChecked"
                                 Style="{StaticResource SidebarNavButtonStyle}" />
                    <RadioButton x:Name="RoutinesNavRadioButton"
                                 Content="Рутины"
                                 HorizontalContentAlignment="Left"
                                 GroupName="PlannerNavigation"
                                 Tag="Routines"
                                 Checked="NavigationRadioButton_OnChecked"
                                 Style="{StaticResource SidebarNavButtonStyle}" />
                    <RadioButton x:Name="TrackersNavRadioButton"
                                 Content="Трекеры"
                                 HorizontalContentAlignment="Left"
                                 GroupName="PlannerNavigation"
                                 Tag="Trackers"
                                 Checked="NavigationRadioButton_OnChecked"
                                 Style="{StaticResource SidebarNavButtonStyle}" />
                    <RadioButton x:Name="CalendarNavRadioButton"
                                 Content="Календарь"
                                 HorizontalContentAlignment="Left"
                                 GroupName="PlannerNavigation"
                                 Tag="Calendar"
                                 Checked="NavigationRadioButton_OnChecked"
                                 Style="{StaticResource SidebarNavButtonStyle}" />
                    <RadioButton x:Name="ArchiveNavRadioButton"
                                 Content="Архив"
                                 HorizontalContentAlignment="Left"
                                 GroupName="PlannerNavigation"
                                 Tag="Archive"
                                 Checked="NavigationRadioButton_OnChecked"
                                 Style="{StaticResource SidebarNavButtonStyle}" />
                </StackPanel>

                <RadioButton x:Name="SettingsNavRadioButton"
                             Grid.Row="3"
                             Content="Настройки"
                             HorizontalContentAlignment="Left"
                             GroupName="PlannerNavigation"
                             Tag="Settings"
                             Checked="NavigationRadioButton_OnChecked"
                             Style="{StaticResource SidebarNavButtonStyle}" />
            </Grid>
        </Border>

        <Grid x:Name="MainContentHost"
              Grid.Column="2">
        <Border x:Name="EmptyPageContent"
                Padding="34"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushStrong}"
                BorderThickness="1"
                CornerRadius="24"
                Visibility="Collapsed">
            <Grid>
                <StackPanel Width="520"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyPageEyebrowTextBlock"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold"
                               Text="Скоро" />
                    <TextBlock x:Name="EmptyPageTitleTextBlock"
                               Margin="0,12,0,0"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Text="Раздел в разработке"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="EmptyPageDescriptionTextBlock"
                               Margin="0,12,0,0"
                               FontSize="15"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Здесь появится содержимое будущего раздела."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="TodayPageContent"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="22"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrushStrong}"
                    BorderThickness="1"
                    CornerRadius="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   Text="Дневной фокус" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Text="Сегодня" />
                        <TextBlock x:Name="TodayOverviewSubtitleTextBlock"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Что требует внимания прямо сейчас" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}" />
                        </ScrollViewer.Resources>
                        <StackPanel>
                            <Button Style="{StaticResource FlatChromeButtonStyle}"
                                    HorizontalContentAlignment="Stretch"
                                    Click="ToggleTodayImportantGroupButton_OnClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TodayImportantGroupChevronTextBlock"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="▾" />
                                    <TextBlock Grid.Column="2"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="Важное" />
                                </Grid>
                            </Button>
                            <StackPanel x:Name="TodayImportantSectionContent"
                                        Margin="0,8,0,0">
                                <TextBlock x:Name="TodayImportantEmptyTextBlock"
                                           Margin="0,0,0,12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Нет просроченных и сегодняшних задач." />
                                <ItemsControl x:Name="TodayImportantItemsControl"
                                              ItemTemplate="{StaticResource TodayOverviewItemTemplate}" />
                            </StackPanel>

                            <Button Margin="0,16,0,0"
                                    Style="{StaticResource FlatChromeButtonStyle}"
                                    HorizontalContentAlignment="Stretch"
                                    Click="ToggleTodayTasksGroupButton_OnClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TodayTasksGroupChevronTextBlock"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="▾" />
                                    <TextBlock Grid.Column="2"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="Задачи" />
                                </Grid>
                            </Button>
                            <StackPanel x:Name="TodayTasksSectionContent"
                                        Margin="0,8,0,0">
                                <TextBlock x:Name="TodayTasksEmptyTextBlock"
                                           Margin="0,0,0,12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Нет задач на будущее, которые можно сделать сегодня." />
                                <ItemsControl x:Name="TodayTaskItemsControl"
                                              ItemTemplate="{StaticResource TodayOverviewItemTemplate}" />
                            </StackPanel>

                            <Button Margin="0,16,0,0"
                                    Style="{StaticResource FlatChromeButtonStyle}"
                                    HorizontalContentAlignment="Stretch"
                                    Click="ToggleTodayOpportunitiesGroupButton_OnClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TodayOpportunitiesGroupChevronTextBlock"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="▾" />
                                    <TextBlock Grid.Column="2"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="Возможности" />
                                </Grid>
                            </Button>
                            <StackPanel x:Name="TodayOpportunitiesSectionContent"
                                        Margin="0,8,0,0">
                                <TextBlock x:Name="TodayOpportunitiesEmptyTextBlock"
                                           Margin="0,0,0,12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Инбокс планирования пуст." />
                                <ItemsControl x:Name="TodayOpportunityItemsControl"
                                              ItemTemplate="{StaticResource TodayOverviewItemTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
