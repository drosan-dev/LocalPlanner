<Window x:Class="LocalPlanner.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:LocalPlanner.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Локальный календарь"
        Width="1440"
        Height="860"
        MinWidth="1180"
        MinHeight="720"
        Background="#FF0B1220"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF0B1220" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF111827" />
        <SolidColorBrush x:Key="PanelMutedBackgroundBrush" Color="#FF0F172A" />
        <SolidColorBrush x:Key="PanelElevatedBrush" Color="#FF132136" />
        <SolidColorBrush x:Key="PanelSubtleBrush" Color="#FF18253B" />
        <SolidColorBrush x:Key="BorderBrushStrong" Color="#FF243042" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#FF304057" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE5E7EB" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFB6C2D2" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF7F8EA3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF8AB4F8" />
        <SolidColorBrush x:Key="AccentStrongBrush" Color="#FF4F8DFD" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#332D6CDF" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFF28B82" />
        <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#332F1C1B" />
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#FF6D3B3A" />
        <SolidColorBrush x:Key="TimelineGridBrush" Color="#1F42526C" />
        <SolidColorBrush x:Key="TimelineMinorTextBrush" Color="#FF94A3B8" />
        <SolidColorBrush x:Key="TimelineResizeBrush" Color="#FFDCE7FB" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style TargetType="Calendar">
            <Setter Property="Background" Value="{StaticResource PanelMutedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
        </Style>

        <Style TargetType="CalendarButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelMutedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PanelSubtleBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentStrongBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentStrongBrush}" />
                </Trigger>
                <Trigger Property="IsInactive" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                </Trigger>
                <Trigger Property="IsToday" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="EditorFieldBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{StaticResource PanelMutedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style x:Key="EditorGroupCardStyle" TargetType="Border" BasedOn="{StaticResource EditorFieldBorderStyle}">
            <Setter Property="Padding" Value="14,14" />
        </Style>

        <Style x:Key="AppScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border Margin="2,0"
                                    Background="{StaticResource PanelMutedBackgroundBrush}"
                                    CornerRadius="6"
                                    Opacity="0.9" />
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{x:Null}"
                                                  IsTabStop="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AppScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{x:Null}"
                                                  IsTabStop="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="10" />
                                <Setter Property="Width" Value="Auto" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Track" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorFieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{StaticResource PanelMutedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="EditorFieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="EditorFieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EditorFieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorTimeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource EditorFieldTextBoxStyle}">
            <Setter Property="Width" Value="78" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="EditorFieldComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="2"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PanelSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsKeyboardFocusWithin" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorFieldComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{StaticResource PanelMutedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource EditorFieldComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBoxBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      IsHitTestVisible="False" />
                                    <TextBlock Grid.Column="1"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="&#xE70D;" />
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Margin="0,8,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource PanelMutedBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrushStrong}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                    <ScrollViewer Margin="6"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup" Property="MinHeight" Value="40" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#332D6CDF" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#332D6CDF" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFE5E7EB" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF0F172A" />
            </Style.Resources>
        </Style>

        <Style x:Key="EditorDatePickerTextBoxStyle" TargetType="{x:Type primitives:DatePickerTextBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="SelectedDateFormat" Value="Short" />
            <Setter Property="CalendarStyle" Value="{StaticResource {x:Type Calendar}}" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="DatePickerBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <primitives:DatePickerTextBox x:Name="PART_TextBox"
                                                              Grid.Column="0"
                                                              Margin="{TemplateBinding Padding}"
                                                              Background="Transparent"
                                                              VerticalAlignment="Center"
                                                              Style="{StaticResource EditorDatePickerTextBoxStyle}" />
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Margin="0"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        Focusable="False"
                                        Foreground="{StaticResource TextSecondaryBrush}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                                FontSize="9"
                                               Text="&#xE70D;" />
                                </Button>
                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       PopupAnimation="Fade"
                                       StaysOpen="False">
                                    <Border Margin="0,8,0,0"
                                            Background="{StaticResource PanelMutedBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrushStrong}"
                                            BorderThickness="1"
                                            CornerRadius="18">
                                        <Calendar x:Name="PART_Calendar"
                                                  Margin="8"
                                                  BorderThickness="0"
                                                  Background="{StaticResource PanelMutedBackgroundBrush}"
                                                  Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DatePickerBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="PART_Button" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DatePickerBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="PART_Button" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type primitives:CalendarItem}">
            <Setter Property="Background" Value="{StaticResource PanelMutedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>

        <Style x:Key="ViewModeRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource PanelElevatedBrush}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="EventCardTemplate" DataType="{x:Type vm:EventListItemViewModel}">
            <Border Margin="0,0,0,10"
                    Background="{Binding AccentSurfaceBrush}"
                    BorderBrush="{Binding AccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    PreviewMouseLeftButtonDown="EventCard_OnPreviewMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{Binding AccentBrush}"
                            CornerRadius="14,0,0,14" />

                    <StackPanel Grid.Column="1"
                                Margin="12,12,12,12">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding Title}" />
                            <Border Margin="8,0,0,0"
                                    Padding="8,2"
                                    Background="{Binding AccentBadgeBrush}"
                                    CornerRadius="10">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding AccentBrush}"
                                           Text="{Binding TimeLabel}" />
                            </Border>
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding ScheduleSummary}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Description}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TimelineHourTemplate" DataType="{x:Type vm:TimeSlotViewModel}">
            <Grid Height="64">
                <TextBlock Margin="0,2,10,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Foreground="{StaticResource TimelineMinorTextBrush}"
                           FontSize="11"
                           Text="{Binding Label}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TimelineSlotLineTemplate" DataType="{x:Type vm:TimeSlotViewModel}">
            <Border Height="64"
                    BorderBrush="{StaticResource TimelineGridBrush}"
                    BorderThickness="0,0,0,1" />
        </DataTemplate>

        <DataTemplate x:Key="WeekHeaderTemplate" DataType="{x:Type vm:WeekDayColumnViewModel}">
            <Border Margin="6,0"
                    Padding="12,10"
                    Background="{Binding SurfaceBrush}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="{Binding BorderThickness}"
                    CornerRadius="14"
                    ToolTip="{Binding AccessibilityLabel}">
                <Button Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Click="WeekDayButton_OnClick"
                        Tag="{Binding Date}">
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding DayOfWeekLabel}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding DayNumberLabel}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding SummaryLabel}" />
                    </StackPanel>
                </Button>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TimelineEventTemplate" DataType="{x:Type vm:TimeGridEventViewModel}">
            <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=Canvas}, Path=ActualWidth}"
                  Height="{Binding Height}">
                <Grid Margin="6,0,6,0"
                      Background="Transparent"
                      Cursor="SizeAll"
                      PreviewMouseLeftButtonDown="TimelineEventThumb_OnPreviewMouseLeftButtonDown"
                      PreviewMouseLeftButtonUp="TimelineInteractionSurface_OnMouseLeftButtonUp"
                      PreviewMouseMove="TimelineInteractionSurface_OnMouseMove"
                      LostMouseCapture="TimelineInteractionSurface_OnLostMouseCapture">
                    <Border Background="{Binding AccentSurfaceBrush}"
                            BorderBrush="{Binding AccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid Margin="10,8,10,10">
                            <Grid.RowDefinitions>
