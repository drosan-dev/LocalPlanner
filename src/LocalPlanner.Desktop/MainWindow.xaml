                    <TextBlock FontWeight="SemiBold"
                               Text="Повторяемость (RRULE)" />
                    <TextBox x:Name="RRuleTextBox"
                             Margin="0,6,0,18"
                             Padding="10" />

                    <WrapPanel Margin="0,0,0,16">
                        <Button Padding="16,8"
                                Margin="0,0,10,10"
                                Background="{StaticResource AccentStrongBrush}"
                                BorderBrush="{StaticResource AccentStrongBrush}"
                                Foreground="White"
                                Click="SaveButton_OnClick"
                                Content="Сохранить" />
                        <Button Padding="16,8"
                                Margin="0,0,10,10"
                                Background="{StaticResource PanelSubtleBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                Click="NewButton_OnClick"
                                Content="Новое событие" />
                        <Button x:Name="DeleteButton"
                                Padding="16,8"
                                Margin="0,0,0,10"
                                Background="{StaticResource DangerSurfaceBrush}"
                                BorderBrush="{StaticResource DangerBorderBrush}"
                                Foreground="{StaticResource DangerBrush}"
                                Click="DeleteButton_OnClick"
                                Content="Удалить"
                                IsEnabled="False" />
                    </WrapPanel>

                    <Border Padding="12"
                            Background="{StaticResource PanelMutedBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushStrong}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <TextBlock x:Name="StatusTextBlock"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

